node_modules/
dist/
dist-web/
*.tsbuildinfo

# 측정 세션 산출물 (트레이스 원본이 커서 커밋하지 않음)
runs/

# "왜 이렇게 했는가" 는 기능 문서(docs/spec/ 의 ### 결정) · 디자인 문서(docs/design/) ·
# DECISIONS-TO-REVISIT.md 에 남긴다. 작업 도구가 만드는 렛저 · 계획서 · 리뷰 diff 는 커밋하지 않는다.
.superpowers/
docs/superpowers/

# 테스트 픽스처는 예외 — fixtures/ 는 의도적으로 커밋한다

.DS_Store
*.log
.env
.env.local

# 실기기 조사용 스크래치 (커밋하지 않는다)
.scratch/

# 에이전트 툴링 상태 (기계가 쓰는 캐시 — 작업 맥락이 아니다)
.super-soop/

# 디자인 핸드오프 원본 zip — 푼 내용이 docs/design/gui/ 에 있으므로 zip 은 커밋하지 않는다
*.zip

# prepack 이 루트에서 복사해 넣는 것들. 정본은 루트에 하나씩뿐이고
# 복사본을 커밋하면 두 벌이 되어 조용히 어긋난다 (scripts/prepack.mjs).
packages/*/LICENSE
packages/cli/README.md
packages/cli/media/
