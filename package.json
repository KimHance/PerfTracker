{
  "name": "perftracker-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc --build",
    "gui": "npm run dev -w @perftracker/gui",
    "typecheck": "tsc --build && tsc -p tsconfig.test.json && tsc -p packages/gui/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:device": "vitest run --config vitest.device.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
